# Copy to .env.local and adjust. Values here are the defaults.

# Base URL for API requests. Use a full URL for a backend on another origin.
VITE_API_URL=/api/v1

# Development only: where the dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:3000

# Development only: set to false to turn off the mock API (MSW) and send
# requests to the real backend through the proxy above.
VITE_API_MOCKS=true
